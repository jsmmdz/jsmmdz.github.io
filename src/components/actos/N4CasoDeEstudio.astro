---
/**
 * Acto N4 — el caso de estudio como plantilla (T32): la historia contada en cristales de vidrio 3D por la
 * mitad izquierda y, a la derecha, la foto de cada paso que se funde con la siguiente al ritmo del scroll
 * (la sección roja de Zero). Un caso se arma solo con su frontmatter (`historia` y `fondo`).
 *
 * El documento no se desplaza: el scroll es virtual (`lib/n4/scroll.ts`). Con WebGL, los cristales, su
 * texto impreso, las cortinas del fondo y la foto los dibuja el canvas persistente; lo de aquí es su
 * copia para lectores de pantalla (el `h2`, el destacado y el texto de cada paso, transparentes y que
 * siguen la caja proyectada de su cristal) y las fotos de respaldo. Sin WebGL, la historia se lee en HTML.
 * El DOM del N4 es transparente sobre el canvas: el fondo lo pone la escena.
 */
import type { CollectionEntry } from 'astro:content';
import { conBase, conMedia } from '@/lib/rutas';
import { variablesCssPortada } from '@/lib/n4/portada';
import { NOMBRE_TIPO, type MedioCaso } from '@/lib/n4/historia';
import { familiaFuente } from '@/lib/n4/design-system';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  disciplina?: CollectionEntry<'disciplinas'>['data'];
}

const { proyecto, disciplina } = Astro.props;
const datos = proyecto.data;
const discSlug = disciplina?.slug ?? 'web';
const mundoUrl = conBase(`${discSlug}/`);

// La sección de resultados (autor, 2026-10-06; hoy solo Bernarte): con `galeria`, los pasos con video salen de la
// historia y van juntos, cada corto en su marco, en el tramo de la sección, antes del paso que los sigue
const galeria = datos.galeria ? datos.historia.filter((p) => p.video) : [];
const historia = datos.galeria ? datos.historia.filter((p) => !p.video) : datos.historia;
const galeriaEn = datos.galeria ? datos.historia.findIndex((p) => p.video) : -1;
// Las fotos: la portada (medio −1, donde aterriza el vuelo) y la de cada paso
const portada: MedioCaso = { src: datos.portada.src, ancho: datos.portada.width, alto: datos.portada.height, alt: `Portada de ${datos.titulo}` };
const fotos: MedioCaso[] = historia.map((p) => ({ src: p.foto.src, ancho: p.foto.width, alto: p.foto.height, alt: p.alt }));
const medios = [portada, ...fotos];
// Los resultados finales con su corto (T38): si su foto (el póster) es vertical, el marco también lo es (9:16)
const hayVideo = historia.some((p) => p.video);
// La exposición del design system (opcional): 5 colores al final del caso
const ds = datos.designSystem;
// Las fuentes del design system se declaran aquí con su archivo (en public/): el cristal las escribe en su
// fuente real y, sin WebGL, también la copia en HTML
const caraFuentes = (ds?.fuentes ?? [])
  .map((f, i) => `@font-face{font-family:"${familiaFuente(i)}";src:url("${conBase(f.archivo)}") format("woff2");font-display:swap}`)
  .join('');
---

<article
  id="act-n4"
  aria-label="Detalle del caso de estudio"
  data-level="N4"
  data-discipline={discSlug}
  data-project={datos.slug}
  data-fondo={datos.fondo}
  data-aspecto-portada={portada.ancho / portada.alto}
  style={`${variablesCssPortada()}; --n4-fondo: ${datos.fondo}`}
>
  <a href={mundoUrl} data-n4-volver class="n4-volver"><span class="n4-flecha" aria-hidden="true">&larr;</span> Volver</a>

  <!-- Las fotos, en el rectángulo de la derecha: la portada (medio −1) y la de cada paso. Con WebGL quedan ocultas tras el canvas. -->
  <div class="n4-medios" role="group" aria-label="Fotos del caso">
    {medios.map((m, i) => (
      <img
        class="n4-medio"
        data-n4-medio={i - 1}
        src={m.src}
        width={m.ancho}
        height={m.alto}
        alt={m.alt}
        loading="eager"
        decoding="async"
        fetchpriority={i === 0 ? 'high' : 'auto'}
        draggable="false"
      />
    ))}
    {hayVideo && <div class="n4-clic-foto" data-n4-clic-foto aria-hidden="true"></div>}
  </div>

  <h1 class="n4-titulo">{datos.titulo}</h1>

  <!-- La historia completa, en orden: con WebGL es transparente y su caja sigue a su cristal -->
  <ol class="n4-historia" data-n4-historia tabindex="-1" aria-label="Historia del caso">
    {historia.map((p, k) => (
      <li
        class="n4-paso"
        data-n4-paso={k}
        data-tipo={p.tipo}
        data-n4-video={p.video ? conMedia(p.video.corto) : undefined}
        data-n4-vertical={p.video ? String(p.foto.height > p.foto.width) : undefined}
      >
        <h2 class="n4-paso-tipo">{NOMBRE_TIPO[p.tipo]}</h2>
        {p.destacado && <p class="n4-paso-destacado">{p.destacado}</p>}
        <p class="n4-paso-texto">{p.texto}</p>
        {p.video && (
          <a class="n4-ver-completo" data-n4-ver-completo href={p.video.enlace} target="_blank" rel="noopener noreferrer">
            Ver completo<span aria-hidden="true"> ↗</span><span class="n4-solo-lectores"> (video en Google Drive, se abre en otra pestaña)</span>
          </a>
        )}
      </li>
    ))}
  </ol>

  <!-- El design system (antes del resultado, a pantalla completa): con WebGL, cada color es un cristal teñido y
       las tipografías van en un cristal grande; estas copias (transparentes) siguen sus cajas. Sin WebGL se ven en HTML. -->
  {ds && (
    <section class="n4-ds" data-n4-ds aria-label="Design system">
      <h2 class="n4-ds-titulo" data-n4-ds-titulo>Design system</h2>
      <ul class="n4-colores" aria-label="Paleta">
        {ds.paleta.map((hex, i) => (
          <li class="n4-color" data-n4-color={i} data-hex={hex} style={`--n4-color: ${hex}`}>
            <span class="n4-color-muestra" aria-hidden="true"></span>
            <span class="n4-color-hex">{hex.toUpperCase()}</span>
          </li>
        ))}
      </ul>
      <div class="n4-fuentes" data-n4-fuentes>
        <h3 class="n4-fuentes-rotulo">Tipografía</h3>
        <ul class="n4-fuentes-lista">
          {ds.fuentes.map((f, i) => (
            <li class="n4-fuente" data-n4-fuente={i} data-nombre={f.nombre} data-uso={f.uso}>
              <span class="n4-fuente-muestra" aria-hidden="true" style={`font-family: "${familiaFuente(i)}"`}>Aa</span>
              <span class="n4-fuente-nombre" style={`font-family: "${familiaFuente(i)}"`}>{f.nombre}</span>
              <span class="n4-fuente-uso">{f.uso}</span>
            </li>
          ))}
        </ul>
      </div>
      <style is:inline set:html={caraFuentes}></style>
    </section>
  )}

  <!-- La sección de resultados (con `galeria`): con WebGL, cada corto corre en su marco de cristal y estas copias
       (transparentes, salvo el anillo de foco) siguen la caja de su marco; el clic abre el video completo en Drive.
       Sin WebGL se ven los pósters en HTML. -->
  {galeria.length > 0 && (
    <section class="n4-galeria" data-n4-galeria data-n4-en={galeriaEn} aria-label="Resultados">
      <h2 class="n4-solo-lectores">Resultados</h2>
      <ul class="n4-galeria-lista">
        {galeria.map((p, i) => (
          <li class="n4-galeria-item" data-n4-galeria-item={i} data-n4-video={p.video ? conMedia(p.video.corto) : undefined}>
            <img class="n4-galeria-poster" src={p.foto.src} width={p.foto.width} height={p.foto.height} alt={p.alt} loading="eager" decoding="async" draggable="false" />
            <a class="n4-galeria-enlace" data-n4-galeria-enlace href={p.video?.enlace} target="_blank" rel="noopener noreferrer">
              {p.destacado && <span class="n4-galeria-destacado">{p.destacado}</span>}
              <span class="n4-galeria-texto">{p.texto}</span>
              <span class="n4-galeria-ver">Ver completo<span aria-hidden="true"> ↗</span><span class="n4-solo-lectores"> (video en Google Drive, se abre en otra pestaña)</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- El anillo de progreso de Landberg: abajo a la izquierda, con arco desde las 12 h -->
  <div class="n4-anillo" data-n4-anillo aria-hidden="true">
    <svg class="n4-anillo-svg" viewBox="0 0 24 24" focusable="false">
      <circle class="n4-anillo-pista" data-n4-anillo-pista fill="none"></circle>
      <circle class="n4-anillo-arco" data-n4-anillo-arco fill="none"></circle>
    </svg>
  </div>
</article>

<script>
  import { isTransitionBeforePreparationEvent, navigate } from 'astro:transitions/client';
  import { transicionConRespaldo } from '@/lib/navigation/instancia';
  import { CasoN4 } from '@/lib/n4/caso';
  import type { ThreeSceneManager } from '@/lib/three/scene-manager';

  // Un solo arranque por visita: los listeners cuelgan de este controlador y se sueltan al irse
  let controlN4: AbortController | null = null;
  let actIniciado: HTMLElement | null = null;
  let caso: CasoN4 | null = null;
  let manager: ThreeSceneManager | null = null;
  let saliendo = false;

  function limpiarN4() {
    if (controlN4) {
      controlN4.abort();
      controlN4 = null;
    }
    caso?.destruir();
    caso = null;
    manager?.desmontarN4();
    manager = null;
    actIniciado = null;
    saliendo = false;
  }

  function registrarProyectoActivo() {
    const act = document.getElementById('act-n4');
    const slug = act?.dataset.project || document.body.dataset.project;
    if (slug) {
      try {
        sessionStorage.setItem('n3_active_project', slug);
      } catch {}
    }
  }

  function initN4() {
    const act = document.getElementById('act-n4');
    if (!act) return;

    // Idempotente: el módulo corre al cargar (o al entrar por ClientRouter) y `astro:page-load`
    // llega después; con el mismo artículo ya iniciado no se arranca otra vez.
    if (act === actIniciado && controlN4) return;
    limpiarN4();
    actIniciado = act;

    registrarProyectoActivo();
    const control = new AbortController();
    controlN4 = control;
    const { signal } = control;
    const volverBtn = act.querySelector<HTMLAnchorElement>('a[data-n4-volver]');
    const contenedor = document.getElementById('webgl-canvas-container');
    const casoActual = new CasoN4(act, { contenedor });
    caso = casoActual;

    // «← Volver» y Esc: salen al mundo. Con la pieza llegada volando, la foto vuela de regreso (1,0 s)
    // antes de que la página cambie; si no, sale con la bisagra negra de siempre
    const salir = () => {
      if (saliendo || !volverBtn) return;
      saliendo = true;
      registrarProyectoActivo();
      transicionConRespaldo({ type: 'BACK_BUTTON_CLICK' }, 1200);
      navigate(volverBtn.href);
    };
    volverBtn?.addEventListener(
      'click',
      (e) => {
        e.preventDefault();
        salir();
      },
      { signal }
    );
    window.addEventListener(
      'keydown',
      (e: KeyboardEvent) => {
        if (e.key !== 'Escape' || e.ctrlKey || e.metaKey || e.altKey) return;
        e.preventDefault();
        salir();
      },
      { signal }
    );

    // Cualquier salida al mundo (el control, Esc o el atrás del navegador) pasa por aquí: se pide que la
    // carga de la página corra a la vez que el vuelo de regreso, y la bisagra negra no tapa la pieza
    document.addEventListener(
      'astro:before-preparation',
      (ev) => {
        if (!isTransitionBeforePreparationEvent(ev) || !caso || !caso.puedeVolarAl(ev.to)) return;
        saliendo = true;
        const cargar = ev.loader;
        // Si el vuelo falla, la navegación sigue igual
        const vuelo = caso.volarDeRegreso().catch(() => undefined);
        ev.loader = async () => {
          await Promise.all([vuelo, cargar()]);
        };
        queueMicrotask(() => document.getElementById('black-hinge-layer')?.classList.remove('activo'));
      },
      { signal }
    );

    casoActual.iniciar();
    if (!contenedor) {
      casoActual.sinWebgl();
      return;
    }

    // Three.js y las fotos del caso se cargan aparte: nada de eso entra en el JS inicial del home
    import('@/lib/three/scene-manager')
      .then(async ({ getThreeSceneManager }) => {
        if (signal.aborted) return;
        manager = getThreeSceneManager();
        const montado = await manager.montarN4(contenedor, casoActual, () => casoActual.sinWebgl());
        if (signal.aborted) return;
        if (!montado) casoActual.sinWebgl();
      })
      .catch(() => {
        casoActual.sinWebgl();
      });
  }

  document.addEventListener('astro:page-load', () => {
    if (document.body.dataset.currentLevel === 'N4') {
      initN4();
    }
  });

  document.addEventListener('astro:before-swap', limpiarN4);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initN4, { once: true });
  } else {
    initN4();
  }
</script>

<style is:global>
  /* El documento del N4 no se desplaza: el scroll es virtual. En escritorio usa el rem de Landberg
     (1 rem = 0,667 vw), como el N3: las medidas de la ficha (x 9 rem, y 6 rem, 70 rem…) valen en cualquier
     ancho. */
  @media (scripting: enabled) {
    html:has(#act-n4) {
      overflow: hidden;
      /* El dedo mueve el caso (scroll.ts): el navegador no roba el gesto para desplazar; el zoom con dos dedos se deja */
      touch-action: pinch-zoom;
    }
  }

  @media (min-width: 1024px) {
    html:has(#act-n4) {
      font-size: clamp(5px, 0.6667vw, 20px);
    }
  }

  /* Medidas propias del N4 que no son rem: el trazo del anillo y el foco */
  #act-n4 {
    --n4-trazo: 2px;
    --n4-foco: 2px;
    /* El centro de la meseta en vertical: en escritorio, el de la ventana; en angosto lo escribe el controlador */
    --n4-meseta-y: 50%;
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    box-sizing: border-box;
    color: var(--color-texto-claro);
    font-family: var(--fuente-texto);
    font-size: 1rem;
    line-height: 1.4;
    /* Transparente: el fondo (negro o las cortinas del caso) lo pone la escena */
    background: transparent;
  }

  #act-n4 :focus-visible {
    outline: var(--n4-foco) solid var(--color-texto-claro);
    outline-offset: var(--n4-foco);
  }

  #act-n4 a,
  #act-n4 button {
    pointer-events: auto;
  }

  /* Con JS y antes de arrancar, lo que entra animado está oculto: así no hay un destello previo */
  @media (scripting: enabled) {
    #act-n4:not(.n4-iniciado) :is(.n4-titulo, .n4-volver) {
      opacity: 0;
    }
  }

  /* ---------- La foto: el mismo rectángulo en el CSS, en el vuelo del N3 y en el mundo WebGL ---------- */
  #act-n4 .n4-medios {
    pointer-events: none;
  }

  #act-n4 .n4-medio {
    position: absolute;
    height: auto;
    aspect-ratio: var(--n4-proporcion);
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  /* El área del clic sobre la foto del corto (T38): el controlador la pone sobre la foto o su marco vertical
     y solo recibe clics mientras el paso activo trae video */
  #act-n4 .n4-clic-foto {
    position: absolute;
    pointer-events: none;
  }

  #act-n4 .n4-clic-foto[data-activo] {
    pointer-events: auto;
    cursor: pointer;
  }

  #act-n4 .n4-clic-foto[data-activo][data-tapado] {
    cursor: auto;
  }

  /* Con WebGL el plano del canvas dibuja la foto; la imagen queda detrás como respaldo */
  #act-n4.n4-con-webgl .n4-medio {
    opacity: 0 !important;
  }

  /* ---------- El título: la frase grande inicial de Zero, centrada en la meseta ---------- */
  #act-n4 .n4-titulo {
    position: absolute;
    margin: 0;
    font-family: var(--fuente-display);
    font-weight: 800;
    /* El tamaño exacto lo mide `lib/n4/titulo.ts` (el mayor que quepa en 44 rem, hasta 4,5 rem) */
    font-size: 2rem;
    line-height: 1.15;
    letter-spacing: var(--tracking-display-lg);
    color: var(--color-texto-claro);
    top: var(--n4-meseta-y);
    transform: translateY(-50%);
  }

  /* ---------- La historia: la copia de cada cristal ---------- */
  #act-n4 .n4-historia {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Con WebGL: transparente, de tamaño fijo, y el controlador la mueve y la escala sobre la caja de su
     cristal (por defecto, fuera de la pantalla). Nunca recibe clics ni foco. */
  #act-n4 .n4-paso {
    position: absolute;
    left: 0;
    top: 0;
    box-sizing: border-box;
    width: calc(40 * 1rem);
    height: calc(30 * 1rem);
    margin: 0;
    padding: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform-origin: 0 0;
    transform: translate3d(0, 150vh, 0);
  }

  #act-n4 .n4-paso-tipo {
    margin: 0 0 0.6rem;
    font-family: var(--fuente-texto);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    color: var(--color-texto-claro);
  }

  #act-n4 .n4-paso-destacado {
    margin: 0 0 0.8rem;
    font-family: var(--fuente-display);
    font-weight: 800;
    font-size: 4rem;
    line-height: 1.05;
    color: var(--color-texto-claro);
  }

  #act-n4 .n4-paso-texto {
    margin: 0;
    font-size: 1.8rem;
    line-height: 1.35;
    color: var(--color-texto-claro);
  }

  /* «Ver completo ↗» (T38): el cristal lo imprime el canvas; este enlace es su copia en el DOM, transparente,
     y solo recibe clics mientras su paso es el activo. Con el foco del teclado se hace visible. */
  #act-n4 .n4-ver-completo {
    position: absolute;
    left: 2.4rem;
    bottom: 2.4rem;
    padding: 0.2rem 0.4rem;
    font-size: 1.8rem;
    font-weight: 600;
    color: var(--color-texto-claro);
    text-decoration: underline;
    pointer-events: none;
  }

  #act-n4 .n4-ver-completo[data-activo] {
    pointer-events: auto;
    cursor: pointer;
  }

  /* Con WebGL el controlador le da su caja exacta (la de la línea que dibuja el cristal): sin relleno propio */
  #act-n4:not(.n4-sin-webgl) .n4-ver-completo {
    color: transparent;
    padding: 0;
    box-sizing: border-box;
    line-height: 1;
    white-space: nowrap;
  }

  /* El clic y el toque llegan a un área mayor que el texto (el controlador da --n4-toque-x/y); el anillo no la sigue */
  #act-n4:not(.n4-sin-webgl) .n4-ver-completo::after {
    content: '';
    position: absolute;
    inset: calc(-1 * var(--n4-toque-y, 0px)) calc(-1 * var(--n4-toque-x, 0px));
  }

  /* Recibe el foco (tabindex -1) cuando el paso con enlace sale, para no soltarlo en <body>: no dibuja anillo */
  #act-n4 .n4-historia:focus,
  #act-n4 .n4-historia:focus-visible {
    outline: none;
  }

  #act-n4:not(.n4-sin-webgl) .n4-paso:has(.n4-ver-completo:focus-visible) {
    opacity: 1;
  }

  #act-n4:not(.n4-sin-webgl) .n4-paso:has(.n4-ver-completo:focus-visible) > :not(.n4-ver-completo) {
    visibility: hidden;
  }

  #act-n4 .n4-solo-lectores {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Sin WebGL: la historia se lee en HTML, un paso a la vez, al centro de la columna y con el fundido de
     las fotos; el fondo es el color plano del caso */
  #act-n4.n4-sin-webgl {
    background: var(--n4-fondo);
  }

  #act-n4.n4-sin-webgl .n4-paso {
    left: calc(31.5 * 1rem - 20 * 1rem);
    top: var(--n4-meseta-y);
    height: auto;
    overflow: visible;
    transform: translateY(-50%);
  }

  #act-n4.n4-sin-webgl .n4-ver-completo {
    position: static;
    display: inline-block;
    margin-top: 1rem;
  }

  /* ---------- El design system ---------- */
  /* El título de la sección: con WebGL lo pone el controlador encima de la paleta */
  #act-n4 .n4-ds-titulo {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    font-family: var(--fuente-display);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.1;
    white-space: nowrap;
    color: var(--color-texto-claro);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, 150vh, 0);
  }

  #act-n4 .n4-colores,
  #act-n4 .n4-fuentes-lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Con WebGL: como la copia de cada paso, transparentes y sobre la caja de su cristal */
  #act-n4 .n4-color,
  #act-n4 .n4-fuentes {
    position: absolute;
    left: 0;
    top: 0;
    box-sizing: border-box;
    width: calc(12 * 1rem);
    height: calc(9 * 1rem);
    margin: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform-origin: 0 0;
    transform: translate3d(0, 150vh, 0);
    font-family: var(--fuente-display);
    font-weight: 800;
    font-size: 1.6rem;
    color: var(--color-texto-claro);
  }

  #act-n4 .n4-fuentes {
    width: calc(40 * 1rem);
    height: calc(30 * 1rem);
    font-weight: 400;
  }

  #act-n4 .n4-color-muestra {
    display: none;
  }

  #act-n4 .n4-fuentes-rotulo {
    margin: 0 0 1rem;
    font-family: var(--fuente-texto);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
