---
/**
 * Acto N4 — el caso de estudio como plantilla (T32): la historia contada en cristales de vidrio 3D por la
 * mitad izquierda y, a la derecha, la foto de cada paso que se funde con la siguiente al ritmo del scroll
 * (la sección roja de Zero). Un caso se arma solo con su frontmatter (`historia` y `fondo`).
 *
 * El documento no se desplaza: el scroll es virtual (`lib/n4/scroll.ts`). Con WebGL, los cristales, su
 * texto impreso, las cortinas del fondo y la foto los dibuja el canvas persistente; lo de aquí es su
 * copia para lectores de pantalla (el `h2`, el destacado y el texto de cada paso, transparentes y que
 * siguen la caja proyectada de su cristal) y las fotos de respaldo. Sin WebGL, la historia se lee en HTML.
 * El DOM del N4 es transparente sobre el canvas: el fondo lo pone la escena.
 */
import type { CollectionEntry } from 'astro:content';
import { conBase } from '@/lib/rutas';
import { variablesCssPortada } from '@/lib/n4/portada';
import { NOMBRE_TIPO, type MedioCaso } from '@/lib/n4/historia';

interface Props {
  proyecto: CollectionEntry<'proyectos'>;
  disciplina?: CollectionEntry<'disciplinas'>['data'];
}

const { proyecto, disciplina } = Astro.props;
const datos = proyecto.data;
const discSlug = disciplina?.slug ?? 'web';
const mundoUrl = conBase(`${discSlug}/`);

// Las fotos: la portada (medio −1, donde aterriza el vuelo) y la de cada paso
const portada: MedioCaso = { src: datos.portada.src, ancho: datos.portada.width, alto: datos.portada.height, alt: `Portada de ${datos.titulo}` };
const fotos: MedioCaso[] = datos.historia.map((p) => ({ src: p.foto.src, ancho: p.foto.width, alto: p.foto.height, alt: p.alt }));
const medios = [portada, ...fotos];
---

<article
  id="act-n4"
  aria-label="Detalle del caso de estudio"
  data-level="N4"
  data-discipline={discSlug}
  data-project={datos.slug}
  data-fondo={datos.fondo}
  data-aspecto-portada={portada.ancho / portada.alto}
  style={`${variablesCssPortada()}; --n4-fondo: ${datos.fondo}`}
>
  <a href={mundoUrl} data-n4-volver class="n4-volver"><span class="n4-flecha" aria-hidden="true">&larr;</span> Volver</a>

  <!-- Las fotos, en el rectángulo de la derecha: la portada (medio −1) y la de cada paso. Con WebGL quedan ocultas tras el canvas. -->
  <div class="n4-medios" role="group" aria-label="Fotos del caso">
    {medios.map((m, i) => (
      <img
        class="n4-medio"
        data-n4-medio={i - 1}
        src={m.src}
        width={m.ancho}
        height={m.alto}
        alt={m.alt}
        loading="eager"
        decoding="async"
        fetchpriority={i === 0 ? 'high' : 'auto'}
        draggable="false"
      />
    ))}
  </div>

  <h1 class="n4-titulo">{datos.titulo}</h1>

  <!-- La historia completa, en orden: con WebGL es transparente y su caja sigue a su cristal -->
  <ol class="n4-historia" data-n4-historia aria-label="Historia del caso">
    {datos.historia.map((p, k) => (
      <li class="n4-paso" data-n4-paso={k} data-tipo={p.tipo}>
        <h2 class="n4-paso-tipo">{NOMBRE_TIPO[p.tipo]}</h2>
        {p.destacado && <p class="n4-paso-destacado">{p.destacado}</p>}
        <p class="n4-paso-texto">{p.texto}</p>
      </li>
    ))}
  </ol>

  <!-- El anillo de progreso de Landberg: abajo a la izquierda, con arco desde las 12 h -->
  <div class="n4-anillo" data-n4-anillo aria-hidden="true">
    <svg class="n4-anillo-svg" viewBox="0 0 24 24" focusable="false">
      <circle class="n4-anillo-pista" data-n4-anillo-pista fill="none"></circle>
      <circle class="n4-anillo-arco" data-n4-anillo-arco fill="none"></circle>
    </svg>
  </div>
</article>

<script>
  import { isTransitionBeforePreparationEvent, navigate } from 'astro:transitions/client';
  import { transicionConRespaldo } from '@/lib/navigation/instancia';
  import { CasoN4 } from '@/lib/n4/caso';
  import type { ThreeSceneManager } from '@/lib/three/scene-manager';

  // Un solo arranque por visita: los listeners cuelgan de este controlador y se sueltan al irse
  let controlN4: AbortController | null = null;
  let actIniciado: HTMLElement | null = null;
  let caso: CasoN4 | null = null;
  let manager: ThreeSceneManager | null = null;
  let saliendo = false;

  function limpiarN4() {
    if (controlN4) {
      controlN4.abort();
      controlN4 = null;
    }
    caso?.destruir();
    caso = null;
    manager?.desmontarN4();
    manager = null;
    actIniciado = null;
    saliendo = false;
  }

  function registrarProyectoActivo() {
    const act = document.getElementById('act-n4');
    const slug = act?.dataset.project || document.body.dataset.project;
    if (slug) {
      try {
        sessionStorage.setItem('n3_active_project', slug);
      } catch {}
    }
  }

  function initN4() {
    const act = document.getElementById('act-n4');
    if (!act) return;

    // Idempotente: el módulo corre al cargar (o al entrar por ClientRouter) y `astro:page-load`
    // llega después; con el mismo artículo ya iniciado no se arranca otra vez.
    if (act === actIniciado && controlN4) return;
    limpiarN4();
    actIniciado = act;

    registrarProyectoActivo();
    const control = new AbortController();
    controlN4 = control;
    const { signal } = control;
    const volverBtn = act.querySelector<HTMLAnchorElement>('a[data-n4-volver]');
    const contenedor = document.getElementById('webgl-canvas-container');
    const casoActual = new CasoN4(act, { contenedor });
    caso = casoActual;

    // «← Volver» y Esc: salen al mundo. Con la pieza llegada volando, la foto vuela de regreso (1,0 s)
    // antes de que la página cambie; si no, sale con la bisagra negra de siempre
    const salir = () => {
      if (saliendo || !volverBtn) return;
      saliendo = true;
      registrarProyectoActivo();
      transicionConRespaldo({ type: 'BACK_BUTTON_CLICK' }, 1200);
      navigate(volverBtn.href);
    };
    volverBtn?.addEventListener(
      'click',
      (e) => {
        e.preventDefault();
        salir();
      },
      { signal }
    );
    window.addEventListener(
      'keydown',
      (e: KeyboardEvent) => {
        if (e.key !== 'Escape' || e.ctrlKey || e.metaKey || e.altKey) return;
        e.preventDefault();
        salir();
      },
      { signal }
    );

    // Cualquier salida al mundo (el control, Esc o el atrás del navegador) pasa por aquí: se pide que la
    // carga de la página corra a la vez que el vuelo de regreso, y la bisagra negra no tapa la pieza
    document.addEventListener(
      'astro:before-preparation',
      (ev) => {
        if (!isTransitionBeforePreparationEvent(ev) || !caso || !caso.puedeVolarAl(ev.to)) return;
        saliendo = true;
        const cargar = ev.loader;
        // Si el vuelo falla, la navegación sigue igual
        const vuelo = caso.volarDeRegreso().catch(() => undefined);
        ev.loader = async () => {
          await Promise.all([vuelo, cargar()]);
        };
        queueMicrotask(() => document.getElementById('black-hinge-layer')?.classList.remove('activo'));
      },
      { signal }
    );

    casoActual.iniciar();
    if (!contenedor) {
      casoActual.sinWebgl();
      return;
    }

    // Three.js y las fotos del caso se cargan aparte: nada de eso entra en el JS inicial del home
    import('@/lib/three/scene-manager')
      .then(async ({ getThreeSceneManager }) => {
        if (signal.aborted) return;
        manager = getThreeSceneManager();
        const montado = await manager.montarN4(contenedor, casoActual, () => casoActual.sinWebgl());
        if (signal.aborted) return;
        if (!montado) casoActual.sinWebgl();
      })
      .catch(() => {
        casoActual.sinWebgl();
      });
  }

  document.addEventListener('astro:page-load', () => {
    if (document.body.dataset.currentLevel === 'N4') {
      initN4();
    }
  });

  document.addEventListener('astro:before-swap', limpiarN4);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initN4, { once: true });
  } else {
    initN4();
  }
</script>

<style is:global>
  /* El documento del N4 no se desplaza: el scroll es virtual. En escritorio usa el rem de Landberg
     (1 rem = 0,667 vw), como el N3: las medidas de la ficha (x 9 rem, y 6 rem, 70 rem…) valen en cualquier
     ancho. */
  @media (scripting: enabled) {
    html:has(#act-n4) {
      overflow: hidden;
      /* El dedo mueve el caso (scroll.ts): el navegador no roba el gesto para desplazar; el zoom con dos dedos se deja */
      touch-action: pinch-zoom;
    }
  }

  @media (min-width: 1024px) {
    html:has(#act-n4) {
      font-size: clamp(5px, 0.6667vw, 20px);
    }
  }

  /* Medidas propias del N4 que no son rem: el trazo del anillo y el foco */
  #act-n4 {
    --n4-trazo: 2px;
    --n4-foco: 2px;
    /* El centro de la meseta en vertical: en escritorio, el de la ventana; en angosto lo escribe el controlador */
    --n4-meseta-y: 50%;
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    box-sizing: border-box;
    color: var(--color-texto-claro);
    font-family: var(--fuente-texto);
    font-size: 1rem;
    line-height: 1.4;
    /* Transparente: el fondo (negro o las cortinas del caso) lo pone la escena */
    background: transparent;
  }

  #act-n4 :focus-visible {
    outline: var(--n4-foco) solid var(--color-texto-claro);
    outline-offset: var(--n4-foco);
  }

  #act-n4 a,
  #act-n4 button {
    pointer-events: auto;
  }

  /* Con JS y antes de arrancar, lo que entra animado está oculto: así no hay un destello previo */
  @media (scripting: enabled) {
    #act-n4:not(.n4-iniciado) :is(.n4-titulo, .n4-volver) {
      opacity: 0;
    }
  }

  /* ---------- La foto: el mismo rectángulo en el CSS, en el vuelo del N3 y en el mundo WebGL ---------- */
  #act-n4 .n4-medios {
    pointer-events: none;
  }

  #act-n4 .n4-medio {
    position: absolute;
    height: auto;
    aspect-ratio: var(--n4-proporcion);
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  /* Con WebGL el plano del canvas dibuja la foto; la imagen queda detrás como respaldo */
  #act-n4.n4-con-webgl .n4-medio {
    opacity: 0 !important;
  }

  /* ---------- El título: la frase grande inicial de Zero, centrada en la meseta ---------- */
  #act-n4 .n4-titulo {
    position: absolute;
    margin: 0;
    font-family: var(--fuente-display);
    font-weight: 800;
    /* El tamaño exacto lo mide `lib/n4/titulo.ts` (el mayor que quepa en 44 rem, hasta 4,5 rem) */
    font-size: 2rem;
    line-height: 1.15;
    letter-spacing: var(--tracking-display-lg);
    color: var(--color-texto-claro);
    top: var(--n4-meseta-y);
    transform: translateY(-50%);
  }

  /* ---------- La historia: la copia de cada cristal ---------- */
  #act-n4 .n4-historia {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Con WebGL: transparente, de tamaño fijo, y el controlador la mueve y la escala sobre la caja de su
     cristal (por defecto, fuera de la pantalla). Nunca recibe clics ni foco. */
  #act-n4 .n4-paso {
    position: absolute;
    left: 0;
    top: 0;
    box-sizing: border-box;
    width: calc(40 * 1rem);
    height: calc(30 * 1rem);
    margin: 0;
    padding: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transform-origin: 0 0;
    transform: translate3d(0, 150vh, 0);
  }

  #act-n4 .n4-paso-tipo {
    margin: 0 0 0.6rem;
    font-family: var(--fuente-texto);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    color: var(--color-texto-claro);
  }

  #act-n4 .n4-paso-destacado {
    margin: 0 0 0.8rem;
    font-family: var(--fuente-display);
    font-weight: 800;
    font-size: 4rem;
    line-height: 1.05;
    color: var(--color-texto-claro);
  }

  #act-n4 .n4-paso-texto {
    margin: 0;
    font-size: 1.8rem;
    line-height: 1.35;
    color: var(--color-texto-claro);
  }

  /* Sin WebGL: la historia se lee en HTML, un paso a la vez, al centro de la columna y con el fundido de
     las fotos; el fondo es el color plano del caso */
  #act-n4.n4-sin-webgl {
    background: var(--n4-fondo);
  }

  #act-n4.n4-sin-webgl .n4-paso {
    left: calc(31.5 * 1rem - 20 * 1rem);
    top: var(--n4-meseta-y);
    height: auto;
    overflow: visible;
    transform: translateY(-50%);
  }

  /* ---------- «← Volver» ---------- */
  #act-n4 .n4-volver {
    position: fixed;
    display: inline-block;
    z-index: var(--z-hud);
    color: var(--color-texto-claro);
    font-family: var(--fuente-texto);
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  #act-n4 .n4-volver:hover {
    text-decoration: underline;
  }

  /* ---------- El anillo de Landberg ---------- */
  #act-n4 .n4-anillo {
    position: fixed;
    z-index: var(--z-hud);
  }

  #act-n4 .n4-anillo-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  #act-n4 .n4-anillo-pista,
  #act-n4 .n4-anillo-arco {
    stroke-width: var(--n4-trazo);
  }

  /* La pista, en el gris casi negro (#111111 del token de texto oscuro); el arco, en crema */
  #act-n4 .n4-anillo-pista {
    stroke: var(--color-texto-oscuro);
  }

  #act-n4 .n4-anillo-arco {
    stroke: var(--color-texto-claro);
  }

  /* ---------- Escritorio (desde 1024 px): rem de Landberg ---------- */
  @media (min-width: 1024px) {
    /* La foto: x 63 rem, y 6 rem, 70 rem de ancho y 16:10. No se desplaza: cambia en su sitio. */
    #act-n4 .n4-medio {
      left: calc(var(--n4-medio-x) * 1rem);
      top: calc(var(--n4-medio-y) * 1rem);
      width: calc(var(--n4-medio-ancho) * 1rem);
    }

    /* El título: en x 9 rem, centrado en vertical, en una sola línea */
    #act-n4 .n4-titulo {
      left: calc(9 * 1rem);
      white-space: nowrap;
    }

    /* «← Volver»: en el sitio del «VOLVER» del mundo (x 8 rem, y 4 rem) */
    #act-n4 .n4-volver {
      left: calc(8 * 1rem);
      top: calc(4 * 1rem);
      font-size: 1rem;
    }

    /* El anillo: 2,5 rem a 8 rem del borde izquierdo y 5 rem del de abajo */
    #act-n4 .n4-anillo {
      left: calc(8 * 1rem);
      bottom: calc(5 * 1rem);
      width: calc(2.5 * 1rem);
      height: calc(2.5 * 1rem);
    }
  }

  /* ---------- Angosto (< 1024 px): la misma escena, con la foto arriba y los cristales debajo ---------- */
  @media (max-width: 1023px) {
    #act-n4 {
      /* ancho = min(ancho de la ventana − 32, 0,4·alto·1,6); 16:10 */
      --n4-foto-ancho: min(calc(100vw - 32px), calc(0.64 * 100svh));
    }

    #act-n4 .n4-medio {
      width: var(--n4-foto-ancho);
      left: calc((100vw - var(--n4-foto-ancho)) / 2);
      top: 64px;
    }

    /* El título se centra en el espacio de debajo de la foto y puede ocupar más de una línea */
    #act-n4 .n4-titulo {
      left: 16px;
      right: 16px;
      font-size: clamp(1.4rem, 6vw, 2.4rem);
      overflow-wrap: break-word;
    }

    /* «← Volver» arriba a la izquierda (16 px, 16 px); el área de toque crece sin mover el texto */
    #act-n4 .n4-volver {
      left: 16px;
      top: 16px;
      font-size: 0.9rem;
    }

    #act-n4 .n4-volver::after {
      content: '';
      position: absolute;
      inset: -12px -12px -12px -12px;
    }

    #act-n4 .n4-anillo {
      left: 16px;
      bottom: 16px;
      width: 40px;
      height: 40px;
    }

    #act-n4 .n4-paso-destacado {
      font-size: 2.6rem;
    }

    #act-n4 .n4-paso-texto {
      font-size: 1.2rem;
    }

    #act-n4.n4-sin-webgl .n4-paso {
      left: 16px;
      width: calc(100vw - 32px);
    }
  }

  /* Sin JS: la historia se lee como una página corrida sobre el color del caso; la foto, que depende del
     scroll virtual, no se muestra */
  @media (scripting: none) {
    #act-n4 {
      position: static;
      overflow: visible;
      pointer-events: auto;
      min-height: 100vh;
      padding: calc(6 * 1rem) calc(9 * 1rem);
      background: var(--n4-fondo);
    }

    #act-n4 .n4-titulo,
    #act-n4 .n4-volver {
      position: static;
      transform: none;
      white-space: normal;
    }

    #act-n4 .n4-paso {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      opacity: 1;
      transform: none;
      margin-top: calc(3 * 1rem);
    }

    #act-n4 .n4-medios,
    #act-n4 .n4-anillo {
      display: none;
    }
  }
</style>
