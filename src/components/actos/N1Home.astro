---
/**
 * N1Home.astro — Acto 1: el home calcado de noth.in (T33; decisiones del autor del 2026-10-03).
 * El titular «JSMMDZ» a todo el ancho, textos chicos en las cuatro esquinas y, sobre el titular, una tinta
 * que sigue al cursor y deja ver el video de materiales (lib/n1/). Referente: noth-1440-tinta.jpg.
 */
import { home } from '@/data/home';

// El titular se parte a mano en letras, cada una en su máscara (la entrada es de lib/n1/titular.ts).
const letras = Array.from(home.nombre);
---

<section
  id="act-n1"
  class="n1-seccion"
  aria-label="Home y presentación"
  data-level="N1"
  data-tinta="inactiva"
>
  <!-- Ancla vacía para el puente con el preloader (T34) -->
  <div id="n1-ancla-preloader" aria-hidden="true"></div>

  <!-- Disparador para la transición de caída hacia N2 -->
  <div id="n1-the-drop-trigger" aria-hidden="true"></div>

  <!-- El titular: el único h1. Cuando el canvas de la tinta lo dibuja, queda solo para los lectores de pantalla. -->
  <h1 class="n1-titular" data-n1-titular aria-label={home.nombre}>{letras.map((letra) => (<span class="n1-mascara" aria-hidden="true"><span class="n1-letra" data-n1-letra>{letra}</span></span>))}<span class="n1-sonda" data-n1-sonda aria-hidden="true"></span></h1>

  <!-- Arriba a la izquierda: la frase y el botón que baja al menú -->
  <div class="n1-arriba-izquierda">
    <p class="n1-frase" data-n1-frase>
      <span class="n1-frase-linea">{home.frase[0]}</span>
      <span class="n1-frase-linea">{home.frase[1]}</span>
    </p>
    <a class="n1-cta" href={home.cta.href} data-n1-cta>
      <span>{home.cta.texto}</span>
      <span class="n1-cta-flecha" aria-hidden="true">↓</span>
    </a>
  </div>

  <!-- Arriba a la derecha: baja al menú (no hay menú desplegable) -->
  <a class="n1-enlace n1-arriba-derecha" href={home.disciplinas.href} data-n1-disciplinas>
    {home.disciplinas.texto} <span aria-hidden="true">::</span>
  </a>

  <!-- Abajo a la izquierda -->
  <p class="n1-rotulo" data-n1-rotulo>{home.rotulo}</p>

  <!-- Abajo a la derecha -->
  <nav class="n1-abajo-derecha" aria-label="Redes">
    <a class="n1-enlace" href={home.linkedin.href} target="_blank" rel="noopener noreferrer">{home.linkedin.texto}</a>
    <span class="n1-separador" aria-hidden="true">/</span>
    <a class="n1-enlace" href={home.instagram.href} target="_blank" rel="noopener noreferrer">{home.instagram.texto}</a>
  </nav>

  <!-- La capa revelada de la tinta. No entra a la precarga: se pide cuando la tinta pasa a activa. -->
  <video
    class="n1-video"
    data-n1-materiales
    src={home.materiales.src}
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  ></video>
</section>

<script>
  import { iniciarHome, type ControladorHome } from '@/lib/n1/home';

  let controlador: ControladorHome | null = null;
  let seccionIniciada: HTMLElement | null = null;

  // Idempotente: el módulo corre al cargar y `astro:page-load` llega después; con la misma sección no
  // se vuelve a iniciar.
  function inicializarN1(): void {
    const seccion = document.getElementById('act-n1');
    if (!seccion || (controlador && seccion === seccionIniciada)) return;
    controlador?.destruir();
    seccionIniciada = seccion;
    controlador = iniciarHome();
  }

  function destruirN1(): void {
    controlador?.destruir();
    controlador = null;
    seccionIniciada = null;
  }

  document.addEventListener('astro:page-load', inicializarN1);
  document.addEventListener('astro:before-swap', destruirN1);

  if (document.readyState !== 'loading') {
    inicializarN1();
  } else {
    document.addEventListener('DOMContentLoaded', inicializarN1, { once: true });
  }
</script>

<style>
  .n1-seccion {
    /* Margen de noth.in: 18 px a 1440, proporcional, con un mínimo en pantallas chicas. */
    --n1-margen: max(var(--espacio-sm), 1.25vw);
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 100vh;
    box-sizing: border-box;
    overflow: hidden;
    color: var(--texto-activo);
    /* K8: el lavado. 0 es el crema; 1, el fondo del menú. Lo mueve lib/n1/home.ts con la caída. */
    background-color: color-mix(
      in srgb,
      var(--fondo-crema-web) calc(var(--n1-lavado, 0) * 100%),
      var(--color-crema-base)
    );
  }

  #n1-ancla-preloader {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  #n1-the-drop-trigger {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    pointer-events: none;
  }

  /* El canvas de la tinta lo crea lib/n1/home.ts: por eso :global. Va debajo de los textos. */
  .n1-seccion :global(.n1-tinta) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    z-index: 0;
  }

  /* ---------- El titular ---------- */

  .n1-titular {
    position: absolute;
    left: var(--n1-margen);
    right: var(--n1-margen);
    top: 0;
    bottom: 0;
    height: fit-content;
    margin: auto 0;
    display: flex;
    justify-content: center;
    align-items: baseline;
    font-family: var(--fuente-display);
    font-weight: 800;
    /* lib/n1/titular.ts ajusta el tamaño para que «JSMMDZ» llene el ancho; esto es el respaldo. */
    font-size: var(--n1-titular-tam, 21vw);
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
    color: var(--color-casa);
    z-index: 1;
    user-select: none;
  }

  /* Cuando el canvas dibuja el titular, el h1 deja de verse pero sigue en el árbol de accesibilidad. */
  .n1-seccion[data-tinta-lienzo] .n1-titular {
    opacity: 0;
  }

  /* La máscara de cada letra: la entrada la sube desde abajo y la máscara la recorta. Se recorta con
     clip-path y no con overflow porque overflow movería la línea base de la letra. */
  .n1-mascara {
    flex: none;
    clip-path: inset(-10% -5%);
  }

  .n1-letra {
    display: block;
  }

  /* Un cuadrito de alto 0 sobre la línea base: de él sale dónde dibujar las letras en el canvas. */
  .n1-sonda {
    flex: none;
    width: 0;
    height: 0;
  }

  /* ---------- Los textos de las esquinas ---------- */

  .n1-arriba-izquierda {
    position: absolute;
    top: var(--espacio-sm);
    left: var(--n1-margen);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--espacio-sm);
  }

  .n1-frase {
    margin: 0;
    font-family: var(--fuente-texto);
    font-weight: 600;
    font-size: var(--tamano-texto-lg);
    line-height: var(--linea-display-lg);
    letter-spacing: var(--tracking-texto-lg);
    color: var(--texto-activo);
  }

  .n1-frase-linea {
    display: block;
  }

  .n1-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--espacio-md);
    padding: var(--espacio-xs) var(--espacio-md);
    border-radius: var(--radio-full);
    background-color: var(--texto-activo);
    color: var(--color-crema-base);
    font-family: var(--fuente-texto);
    font-weight: 600;
    font-size: var(--tamano-rotulo);
    line-height: var(--linea-rotulo);
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity var(--duracion-corta) var(--curva-entrada);
  }

  .n1-cta:hover {
    opacity: 0.8;
  }

  .n1-enlace {
    color: var(--texto-activo);
    font-family: var(--fuente-texto);
    font-weight: 600;
    font-size: var(--tamano-rotulo);
    line-height: var(--linea-rotulo);
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    text-decoration: none;
    text-underline-offset: 4px;
  }

  .n1-enlace:hover {
    text-decoration: underline;
  }

  /* § 5: el foco visible sobre crema es #111111 (el texto oscuro), no la amatista del foco global. */
  .n1-cta:focus-visible,
  .n1-enlace:focus-visible {
    outline: 2px solid var(--color-texto-oscuro);
    outline-offset: 3px;
  }

  .n1-arriba-derecha {
    position: absolute;
    top: var(--espacio-sm);
    right: var(--n1-margen);
    z-index: 2;
  }

  .n1-rotulo {
    position: absolute;
    left: var(--n1-margen);
    bottom: var(--espacio-sm);
    z-index: 2;
    margin: 0;
    font-family: var(--fuente-texto);
    font-weight: 600;
    font-size: var(--tamano-texto-sm);
    line-height: var(--linea-texto-sm);
    letter-spacing: var(--tracking-texto-lg);
    color: var(--texto-activo);
  }

  .n1-abajo-derecha {
    position: absolute;
    right: var(--n1-margen);
    bottom: var(--espacio-sm);
    z-index: 2;
    display: flex;
    align-items: center;
    gap: var(--espacio-sm);
  }

  .n1-separador {
    font-family: var(--fuente-texto);
    font-weight: 600;
    font-size: var(--tamano-rotulo);
    color: var(--texto-activo);
  }

  /* El video se queda en el DOM, sin verse: la tinta lo toma como textura. */
  .n1-video {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  /* Celular (el ajuste fino es del pulido): la frase no pisa «Disciplinas ::» y el rótulo sube sobre
     los enlaces para que no se encimen. */
  @media (max-width: 768px) {
    .n1-frase {
      font-size: var(--tamano-texto-md);
      max-width: calc(100vw - 2 * var(--n1-margen) - 8rem);
    }

    .n1-rotulo {
      bottom: calc(var(--espacio-sm) + var(--espacio-lg));
    }
  }
</style>
