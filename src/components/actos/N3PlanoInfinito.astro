---
/**
 * Componente del Acto N3 — el mundo de la disciplina, calcado de Landberg (T30).
 *
 * La pista es una fila de 7 tarjetas en bucle: los casos reales y el resto «Próximamente». Son
 * elementos DOM de verdad (enfocables, con enlace) cuya posición alimenta al mundo WebGL; con WebGL
 * su contenido no se ve (lo dibuja la cinta), sin WebGL se ve como una fila de tarjetas.
 * HUD en tres esquinas: volver (arriba-izq), disciplina (arriba-der), cantidad (abajo-der).
 */
import type { CollectionEntry } from 'astro:content';
import { conBase, conMedia } from '@/lib/rutas';

interface Props {
  disciplina?: CollectionEntry<'disciplinas'>['data'];
  proyectos?: CollectionEntry<'proyectos'>[];
}

// Las tarjetas del bucle (decisión del autor, 2026-09-29): 7 por disciplina
const TARJETAS_DEL_BUCLE = 7;
// Proporción de las tarjetas «Próximamente» (las de solo texto)
const ASPECTO_BLOQUEADA = 16 / 9;

const { disciplina, proyectos = [] } = Astro.props;
const volverUrl = disciplina ? conBase(`#${disciplina.slug}`) : conBase('');

const reales = proyectos.slice(0, TARJETAS_DEL_BUCLE);
const bloqueadas = Math.max(0, TARJETAS_DEL_BUCLE - reales.length);
---

{disciplina ? (
  <section
    id="act-n3"
    class="n3-escenario"
    aria-label="Mundo de la disciplina"
    data-level="N3"
    data-discipline={disciplina.slug}
    data-velocidad="0"
  >
    <!-- HUD en las tres esquinas (spec § 5): medidas de Landberg en rem -->
    <aside data-n3-hud class="n3-hud" aria-label="Navegación del mundo">
      <div data-esquina="arriba-izquierda" class="n3-esquina n3-esq-arriba-izq">
        <a href={volverUrl} data-n3-volver class="n3-hud-texto n3-hud-volver">
          <span class="n3-flecha" aria-hidden="true">&larr;</span> VOLVER
        </a>
      </div>

      <div data-esquina="arriba-derecha" class="n3-esquina n3-esq-arriba-der">
        <span class="n3-hud-texto">{disciplina.nombre}</span>
      </div>

      <div data-esquina="abajo-derecha" class="n3-esquina n3-esq-abajo-der">
        <span class="n3-hud-texto">
          {`${proyectos.length} ${proyectos.length === 1 ? 'PIEZA' : 'PIEZAS'}`}
        </span>
      </div>
    </aside>

    <!-- La pista: cada tarjeta lleva en su transform su posición envuelta en el bucle -->
    <div class="n3-pista" data-n3-etiquetas role="group" aria-label="Proyectos de la disciplina">
      {reales.map((p) => {
        const portada = p.data.portada;
        const aspecto = portada.width / portada.height;
        return (
          <article
            class="n3-tarjeta"
            data-n3-tarjeta
            data-titulo={p.data.titulo}
            data-aspecto={aspecto}
            data-video={p.data.video ? conMedia(p.data.video) : undefined}
            style={`--n3-aspecto: ${aspecto}`}
          >
            <img
              class="n3-portada"
              src={portada.src}
              alt=""
              width={portada.width}
              height={portada.height}
              decoding="async"
              draggable="false"
            />
            <p class="n3-titulo">{p.data.titulo}</p>
            <a
              href={conBase(`${disciplina.slug}/${p.data.slug}/`)}
              class="n3-enlace"
              data-slug={p.data.slug}
              draggable="false"
              aria-label={`Entrar al caso de estudio: ${p.data.titulo}`}
            ></a>
          </article>
        );
      })}
      {Array.from({ length: bloqueadas }, () => (
        <article
          class="n3-tarjeta n3-bloqueada"
          data-n3-tarjeta
          data-bloqueada
          data-titulo="Próximamente"
          data-aspecto={ASPECTO_BLOQUEADA}
          style={`--n3-aspecto: ${ASPECTO_BLOQUEADA}`}
        >
          <p class="n3-proximamente">Próximamente</p>
        </article>
      ))}
    </div>
  </section>
) : (
  <section id="act-n3" class="n3-escenario" data-level="N3" aria-hidden="true"></section>
)}

<script>
  import { navigate } from 'astro:transitions/client';
  import { transicionConRespaldo } from '@/lib/navigation/instancia';
  import { precargar } from '@/lib/navigation/precarga';
  import type { ThreeSceneManager } from '@/lib/three/scene-manager';
  import type { ControladorN3, TarjetaDom } from '@/lib/three/n3/controlador';

  let sceneManagerInstance: ThreeSceneManager | null = null;
  let controlador: ControladorN3 | null = null;
  // Un solo arranque por visita: los listeners cuelgan de este controlador y se sueltan al irse
  let controlN3: AbortController | null = null;
  let actIniciado: HTMLElement | null = null;
  // La navegación que acompaña a un vuelo no pasa por la bisagra negra: el vuelo ya es la transición
  let llegadaDeVuelo = false;

  function limpiarN3Act() {
    llegadaDeVuelo = false;
    if (controlN3) {
      controlN3.abort();
      controlN3 = null;
    }
    actIniciado = null;
    controlador = null;
  }

  /** Lee las tarjetas del DOM: lo que el mundo WebGL necesita para dibujarlas. */
  function leerTarjetas(pista: HTMLElement): TarjetaDom[] {
    return Array.from(pista.querySelectorAll<HTMLElement>('[data-n3-tarjeta]')).map((el) => ({
      el,
      slug: el.querySelector<HTMLAnchorElement>('a[data-slug]')?.dataset.slug ?? null,
      titulo: el.dataset.titulo ?? '',
      img: el.querySelector<HTMLImageElement>('img'),
      video: el.dataset.video ?? null,
      aspecto: Number(el.dataset.aspecto) || 16 / 9,
    }));
  }

  function initN3Act() {
    const act = document.getElementById('act-n3');
    if (!act || act.getAttribute('aria-hidden') === 'true') return;

    // Idempotente: el módulo corre al cargar (o al entrar por ClientRouter) y `astro:page-load`
    // llega después; con la misma sección ya iniciada no se arranca otra vez.
    if (act === actIniciado && controlN3) return;
    limpiarN3Act();
    actIniciado = act;

    const control = new AbortController();
    controlN3 = control;
    const { signal } = control;

    const volverBtn = act.querySelector<HTMLAnchorElement>('[data-n3-volver]');
    const canvasContainer = document.getElementById('webgl-canvas-container');
    const pista = act.querySelector<HTMLElement>('[data-n3-etiquetas]');
    const hud = act.querySelector<HTMLElement>('[data-n3-hud]');

    const salirAlMenu = () => {
      if (!volverBtn) return;
      transicionConRespaldo({ type: 'BACK_BUTTON_CLICK' }, 1200);
      navigate(volverBtn.href);
    };

    const irAlCaso = (slug: string, href: string) => {
      transicionConRespaldo({ type: 'SELECT_PROJECT', projectSlug: slug }, 1200);
      navigate(href);
    };

    // El layout enciende la bisagra negra en `astro:before-preparation`. Con un vuelo en curso la pieza
    // vuela sobre el canvas mientras llega la página del caso: si la bisagra se encendiera, taparía el
    // vuelo. Se apaga en una microtarea, antes de que el navegador pinte un solo cuadro con ella.
    document.addEventListener(
      'astro:before-preparation',
      () => {
        if (!llegadaDeVuelo) return;
        queueMicrotask(() => document.getElementById('black-hinge-layer')?.classList.remove('activo'));
      },
      { signal }
    );

    if (volverBtn) {
      volverBtn.addEventListener(
        'click',
        (e) => {
          e.preventDefault();
          salirAlMenu();
        },
        { signal }
      );
    }

    window.addEventListener(
      'keydown',
      (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          e.preventDefault();
          // Esc cancela el vuelo a medias; si no hay vuelo, vuelve al menú
          if (controlador?.volando) {
            controlador.cancelarVuelo();
            return;
          }
          salirAlMenu();
        }
      },
      { signal }
    );

    // El atrás del navegador también cancela el vuelo
    window.addEventListener(
      'popstate',
      () => {
        controlador?.cancelarVuelo();
      },
      { once: true, signal }
    );

    // Clic o Enter en el enlace de un caso real: la pieza vuela al caso (1,0 s) y la página del caso se
    // navega al clic, así su texto entra mientras la pieza todavía vuela (como Landberg). Sin vuelo
    // (movimiento reducido, sin WebGL o ventana angosta) se navega directo.
    if (pista) {
      pista.addEventListener(
        'click',
        (e) => {
          const enlace = e.target instanceof Element ? e.target.closest<HTMLAnchorElement>('a[data-slug]') : null;
          if (!enlace || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          const slug = enlace.dataset.slug;
          if (!slug) {
            navigate(enlace.href);
            return;
          }
          try {
            sessionStorage.setItem('n3_active_project', slug);
          } catch {}
          if (controlador?.abrirCaso(slug)) llegadaDeVuelo = true;
          irAlCaso(slug, enlace.href);
        },
        { signal }
      );
    }

    // Precarga de las páginas de los casos: al clic la página tiene que llegar mientras la pieza vuela
    for (const enlace of act.querySelectorAll<HTMLAnchorElement>('a[data-slug]')) precargar(enlace.href);

    // Si venimos de un caso de estudio, la pieza de origen queda centrada y con el foco
    let returnSlug: string | null = null;
    try {
      returnSlug = sessionStorage.getItem('n3_active_project');
    } catch {}
    const aplicarFoco = () => {
      if (!returnSlug) return;
      act
        .querySelector<HTMLAnchorElement>(`a[data-slug="${returnSlug}"]`)
        ?.focus({ preventScroll: true });
    };
    aplicarFoco();

    if (!pista || !canvasContainer) {
      act.classList.add('n3-sin-webgl');
      return;
    }

    // Three.js y el mundo se cargan aparte: nada de eso entra en el JS inicial del home
    import('@/lib/three/scene-manager')
      .then(async ({ getThreeSceneManager }) => {
        // Si el visitante ya se fue de este acto mientras cargaba el módulo, no se monta nada
        if (signal.aborted) return;
        const manager = getThreeSceneManager();
        sceneManagerInstance = manager;

        const tarjetas = leerTarjetas(pista);
        const montado = await manager.montarN3(
          canvasContainer,
          {
            act,
            contenedor: pista,
            hud,
            tarjetas,
            slugInicial: returnSlug,
          },
          () => {
            act.classList.add('n3-sin-webgl');
          }
        );
        if (signal.aborted) return;
        if (!montado) {
          act.classList.add('n3-sin-webgl');
          return;
        }
        controlador = montado;

        // Con el caso a un clic de distancia, su código se baja ya: al clic la página tiene que montar
        // mientras la pieza todavía vuela
        void import('@/lib/n4/caso');
        void import('@/lib/three/n4/mundo');

        if (returnSlug) {
          aplicarFoco();
          window.setTimeout(aplicarFoco, 80);
          window.setTimeout(aplicarFoco, 250);
          window.setTimeout(() => {
            try {
              sessionStorage.removeItem('n3_active_project');
            } catch {}
          }, 1200);
        }
      })
      .catch(() => {
        act.classList.add('n3-sin-webgl');
      });
  }

  document.addEventListener('astro:page-load', () => {
    if (document.body.dataset.currentLevel === 'N3') {
      initN3Act();
    }
  });

  document.addEventListener('astro:before-swap', () => {
    limpiarN3Act();
    // Si la pieza todavía vuela al caso, el mundo sigue dibujándola hasta que aterrice
    sceneManagerInstance?.soltarN3();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initN3Act, { once: true });
  } else {
    initN3Act();
  }
</script>

<style>
  .n3-escenario {
    /* 1 rem del N3 = 0,667 vw, como Landberg. El font-size de <html> no se toca: afecta a los otros niveles */
    --n3-rem: clamp(5px, 0.6667vw, 20px);
    font-size: var(--n3-rem);
    position: relative;
    width: 100%;
    min-height: 100vh;
    background: transparent;
    color: var(--color-texto-claro);
    box-sizing: border-box;
    overflow: hidden;
    pointer-events: none;
  }

  /* HUD en las esquinas: texto blanco en mayúsculas de 1 rem, márgenes de 8 rem y 4 rem */
  .n3-hud {
    position: fixed;
    inset: 0;
    z-index: var(--z-hud);
    pointer-events: none;
  }

  .n3-esquina {
    position: fixed;
    display: block;
    pointer-events: auto;
    font-size: var(--n3-rem);
    line-height: 1;
  }

  .n3-esq-arriba-izq {
    top: calc(4 * var(--n3-rem));
    left: calc(8 * var(--n3-rem));
  }

  .n3-esq-arriba-der {
    top: calc(4 * var(--n3-rem));
    right: calc(8 * var(--n3-rem));
  }

  .n3-esq-abajo-der {
    bottom: calc(4 * var(--n3-rem));
    right: calc(8 * var(--n3-rem));
  }

  .n3-hud-texto {
    font-family: var(--fuente-texto);
    font-size: var(--n3-rem);
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
    color: var(--color-texto-claro);
    text-decoration: none;
  }

  .n3-hud-volver {
    position: relative;
    display: inline-block;
  }

  /* El texto mide 1 rem; el área de clic se agranda sin mover el texto */
  .n3-hud-volver::after {
    content: '';
    position: absolute;
    inset: -1em -1.4em;
  }

  .n3-hud-volver:hover {
    text-decoration: underline;
  }

  .n3-hud-volver:focus-visible {
    outline: 2px solid var(--color-texto-claro);
    outline-offset: 2px;
  }

  /* La pista: sobre el canvas, invisible con WebGL pero presente (se enfoca y se hace clic) */
  .n3-pista {
    position: fixed;
    inset: 0;
    z-index: var(--z-stage);
    pointer-events: none;
    /* clip y no hidden: el foco de una tarjeta fuera de cuadro no puede desplazar la pista */
    overflow: clip;
  }

  .n3-tarjeta {
    position: absolute;
    left: 0;
    top: 50%;
    flex: none;
    height: min(43.5svh, calc(55 * var(--n3-rem)));
    aspect-ratio: var(--n3-aspecto);
    border-radius: calc(2 * var(--n3-rem));
    transform: translate3d(0, -50%, 0);
    will-change: transform;
    pointer-events: auto;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    -webkit-user-drag: none;
  }

  .n3-portada {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    /* Con WebGL la portada la dibuja la cinta: el elemento sigue ahí pero no se ve */
    opacity: 0;
    pointer-events: none;
  }

  .n3-titulo,
  .n3-proximamente {
    position: absolute;
    left: calc(2 * var(--n3-rem));
    bottom: calc(1 * var(--n3-rem));
    margin: 0;
    font-family: var(--fuente-texto);
    font-size: calc(1.8 * var(--n3-rem));
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 1.2;
    white-space: nowrap;
    color: transparent;
    pointer-events: none;
  }

  .n3-enlace {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: inherit;
    color: transparent;
    text-decoration: none;
    cursor: inherit;
  }

  .n3-enlace:focus-visible {
    outline: 2px solid var(--color-texto-claro);
    outline-offset: 2px;
  }

  .n3-escenario:global(.n3-arrastrando) .n3-tarjeta {
    cursor: grabbing;
  }

  /* Durante el vuelo la pista no recibe nada: la pieza vuela sola */
  .n3-escenario:global(.n3-volando) .n3-tarjeta {
    pointer-events: none;
    cursor: default;
  }

  /* Respaldo accesible sin WebGL: los casos en fila, con sus portadas y enlaces */
  .n3-sin-webgl {
    background-color: var(--color-negro);
    pointer-events: auto;
    overflow: visible;
  }

  .n3-sin-webgl .n3-pista {
    position: relative;
    inset: auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--n3-rem);
    min-height: 100vh;
    padding: calc(8 * var(--n3-rem));
    overflow-x: auto;
    overflow-y: hidden;
    pointer-events: auto;
    box-sizing: border-box;
  }

  .n3-sin-webgl .n3-tarjeta {
    position: relative;
    top: auto;
    transform: none !important;
    will-change: auto;
    cursor: default;
    overflow: visible;
  }

  .n3-sin-webgl .n3-portada {
    opacity: 1;
  }

  .n3-sin-webgl .n3-titulo,
  .n3-sin-webgl .n3-proximamente {
    color: var(--color-texto-claro);
  }

  .n3-sin-webgl .n3-bloqueada {
    background-color: var(--color-texto-oscuro);
  }
</style>
