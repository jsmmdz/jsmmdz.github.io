---
/**
 * Capítulo 5 («Hallazgos»). En el MDX del caso: `<Hallazgos items={frontmatter.hallazgos} />`. Los
 * hallazgos llegan por la propiedad, no por estado global: con el build de Astro renderizando páginas
 * en paralelo, un estado global podía filtrar los hallazgos de un caso a otro.
 */
import Capitulo from './Capitulo.astro';
import { CAPITULOS } from '@/lib/n4/capitulos';

interface Props {
  items?: string[];
}

const { items = [] } = Astro.props;
---

<Capitulo k={5} titulo={CAPITULOS[5]}>
  {items.length > 0 ? (
    <ul class="n4-lista">
      {items.map((hallazgo) => <li>{hallazgo}</li>)}
    </ul>
  ) : (
    <p>Sin hallazgos documentados.</p>
  )}
</Capitulo>
