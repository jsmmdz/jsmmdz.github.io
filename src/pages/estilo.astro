---
import FilmLayout from '@/layouts/FilmLayout.astro';
---

<FilmLayout
  title="Sistema de Diseño — Vocabulario Visual y Tokens"
  description="Página de muestra y auditoría técnica del sistema de diseño cinemático."
  initialLevel="N1"
  initialDiscipline="web"
>
  <div class="estilo-container">
    <!-- Encabezado de la Guía Visual -->
    <header class="estilo-header">
      <div class="tipo-rotulo metadato-header">SISTEMA DE DISEÑO · TAREA T2 · JSMMDZ</div>
      <h1 class="tipo-display display-2xl titulo-estilo">Vocabulario Cinemático</h1>
      <p class="tipo-texto texto-lg subtitulo-estilo">
        Tokens, escalas tipográficas fluidas, paleta joya, cremas teñidos en OKLCH y dinámicas de aceleración.
        Sin mobiliario (R19), con negro absoluto como bisagra (R2) y control reactivo por atributos de nivel y disciplina.
      </p>
    </header>

    <!-- Controles Dinámicos de Prueba de Nivel y Disciplina (Ajuste A2) -->
    <section class="estilo-seccion">
      <div class="tipo-rotulo rotulo-seccion">00 / INSPECTOR DE ESTADO ACTIVO</div>
      <h2 class="tipo-display display-md">Simulador de Nivel y Disciplina</h2>
      <p class="tipo-texto texto-md">
        Cambia los atributos de <code>&lt;body&gt;</code> para auditar cómo interpolan <code>--fondo-activo</code>, <code>--texto-activo</code> y <code>--acento-activo</code>.
      </p>

      <div class="controles-grupo">
        <div class="control-fila">
          <span class="tipo-rotulo etiqueta-control">NIVEL:</span>
          <div class="botones-selector" id="selector-nivel">
            <button type="button" class="btn-token activo" data-nivel="N1">N0 / N1 (Home)</button>
            <button type="button" class="btn-token" data-nivel="N2">N2 (Menú)</button>
            <button type="button" class="btn-token" data-nivel="N3">N3 (Mundo 3D)</button>
            <button type="button" class="btn-token" data-nivel="N4">N4 (Estudio)</button>
          </div>
        </div>

        <div class="control-fila">
          <span class="tipo-rotulo etiqueta-control">DISCIPLINA:</span>
          <div class="botones-selector" id="selector-disciplina">
            <button type="button" class="btn-token activo" data-disciplina="web">Web (Lapislázuli)</button>
            <button type="button" class="btn-token" data-disciplina="motion">Motion (Ámbar)</button>
            <button type="button" class="btn-token" data-disciplina="3d">3D (Esmeralda)</button>
            <button type="button" class="btn-token" data-disciplina="videojuegos">Videojuegos (Rubí)</button>
            <button type="button" class="btn-token" data-disciplina="editorial">Editorial (Ónix)</button>
          </div>
        </div>
      </div>

      <div class="indicador-valores-activos">
        <div class="tipo-rotulo">VALORES CSS COMPUTADOS EN TIEMPO REAL:</div>
        <div class="grid-variables-activas">
          <div><span class="tipo-rotulo">--color-activo:</span> <code id="val-color-activo">#6D2FA8</code></div>
          <div><span class="tipo-rotulo">--fondo-activo:</span> <code id="val-fondo-activo">#FAF8F5</code></div>
          <div><span class="tipo-rotulo">--texto-activo:</span> <code id="val-texto-activo">#111111</code></div>
          <div><span class="tipo-rotulo">--acento-activo:</span> <code id="val-acento-activo">#6D2FA8</code></div>
        </div>
      </div>
    </section>

    <!-- 1. Paleta Cromática Cerrada -->
    <section class="estilo-seccion">
      <div class="tipo-rotulo rotulo-seccion">01 / PALETA CROMÁTICA CERRADA</div>
      <h2 class="tipo-display display-md">Tonos Joya & Color de la Casa</h2>
      <p class="tipo-texto texto-md">
        Seis tonos puros inmutables. Amatista es el color de la casa (N0, N1 y sistema). Las 5 disciplinas siguen el orden cerrado del recorrido.
      </p>

      <div class="muestrario-paleta">
        <div class="muestra-color" style="--color-local: var(--color-casa);">
          <div class="bloque-color"></div>
          <div class="datos-color">
            <span class="tipo-display texto-md">Amatista</span>
            <span class="tipo-rotulo">CASA · N0 / N1</span>
            <code>#6D2FA8</code>
          </div>
        </div>

        <div class="muestra-color" style="--color-local: var(--color-web);">
          <div class="bloque-color"></div>
          <div class="datos-color">
            <span class="tipo-display texto-md">Lapislázuli</span>
            <span class="tipo-rotulo">01 · DISEÑO WEB</span>
            <code>#1C3F94</code>
          </div>
        </div>

        <div class="muestra-color" style="--color-local: var(--color-motion);">
          <div class="bloque-color"></div>
          <div class="datos-color">
            <span class="tipo-display texto-md">Ámbar</span>
            <span class="tipo-rotulo">02 · MOTION GRAPHICS</span>
            <code>#E09B00</code>
          </div>
        </div>

        <div class="muestra-color" style="--color-local: var(--color-3d);">
          <div class="bloque-color"></div>
          <div class="datos-color">
            <span class="tipo-display texto-md">Esmeralda</span>
            <span class="tipo-rotulo">03 · 3D (ROPA + PROPS)</span>
            <code>#046A38</code>
          </div>
        </div>

        <div class="muestra-color" style="--color-local: var(--color-videojuegos);">
          <div class="bloque-color"></div>
          <div class="datos-color">
            <span class="tipo-display texto-md">Rubí</span>
            <span class="tipo-rotulo">04 · VIDEOJUEGOS</span>
            <code>#9B111E</code>
          </div>
        </div>

        <div class="muestra-color" style="--color-local: var(--color-editorial);">
          <div class="bloque-color"></div>
          <div class="datos-color">
            <span class="tipo-display texto-md">Ónix</span>
            <span class="tipo-rotulo">05 · EDITORIAL</span>
            <code>#111111</code>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Cremas Teñidos en OKLCH y Auditoría de Contraste -->
    <section class="estilo-seccion">
      <div class="tipo-rotulo rotulo-seccion">02 / FONDOS CREMA TEÑIDOS (N0, N1, N2)</div>
      <h2 class="tipo-display display-md">Fórmula OKLCH y Ratios WCAG 2.2 Medidos</h2>
      <p class="tipo-texto texto-md">
        Fórmula matemática: <code>color-mix(in oklch, var(--color-[joya]) 6%, var(--color-crema-base) 94%)</code>.
        Garantiza sensación de temperatura lumínica sin saturar, con ratios de contraste superiores a 15:1 contra texto oscuro <code>#111111</code> (Supera WCAG AAA 7:1).
      </p>

      <div class="muestrario-cremas">
        <div class="item-crema" style="--fondo-demo: var(--fondo-crema-casa);">
          <div class="muestra-tinte">
            <span class="tipo-display texto-md">Crema Amatista</span>
            <span class="tipo-rotulo">N0 / N1 Home</span>
            <span class="tipo-rotulo">Resultante: #f5ece3</span>
            <span class="tipo-rotulo valor-contraste">Contraste: 16.18:1 (AAA)</span>
          </div>
        </div>

        <div class="item-crema" style="--fondo-demo: var(--fondo-crema-web);">
          <div class="muestra-tinte">
            <span class="tipo-display texto-md">Fondo del video · web</span>
            <span class="tipo-rotulo">N2 Web · t1, cuadro 0</span>
            <span class="tipo-rotulo">Medido: #AFB6CD</span>
            <span class="tipo-rotulo valor-contraste">Contraste: 9,35:1 (AAA)</span>
          </div>
        </div>

        <div class="item-crema" style="--fondo-demo: var(--fondo-crema-motion);">
          <div class="muestra-tinte">
            <span class="tipo-display texto-md">Fondo del video · motion</span>
            <span class="tipo-rotulo">N2 Motion · t1, último cuadro</span>
            <span class="tipo-rotulo">Medido: #F0D7A1</span>
            <span class="tipo-rotulo valor-contraste">Contraste: 13,43:1 (AAA)</span>
          </div>
        </div>

        <div class="item-crema" style="--fondo-demo: var(--fondo-crema-3d);">
          <div class="muestra-tinte">
            <span class="tipo-display texto-md">Fondo del video · 3D</span>
            <span class="tipo-rotulo">N2 3D · t2, último cuadro</span>
            <span class="tipo-rotulo">Medido: #A4C4AD</span>
            <span class="tipo-rotulo valor-contraste">Contraste: 9,96:1 (AAA)</span>
          </div>
        </div>

        <div class="item-crema" style="--fondo-demo: var(--fondo-crema-videojuegos);">
          <div class="muestra-tinte">
            <span class="tipo-display texto-md">Fondo del video · videojuegos</span>
            <span class="tipo-rotulo">N2 Videojuegos · t3, último cuadro</span>
            <span class="tipo-rotulo">Medido: #DDABAA</span>
            <span class="tipo-rotulo valor-contraste">Contraste: 9,42:1 (AAA)</span>
          </div>
        </div>

        <div class="item-crema item-crema-invertido" style="--fondo-demo: var(--fondo-crema-editorial);">
          <div class="muestra-tinte">
            <span class="tipo-display texto-md">Fondo del video · editorial</span>
            <span class="tipo-rotulo">N2 Editorial · t4, último cuadro · texto claro</span>
            <span class="tipo-rotulo">Medido: #343A3D</span>
            <span class="tipo-rotulo valor-contraste">Contraste: 10,89:1 (AAA)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Los Tres Registros Tipográficos (R7) -->
    <section class="estilo-seccion">
      <div class="tipo-rotulo rotulo-seccion">03 / LOS TRES REGISTROS TIPOGRÁFICOS (R7)</div>
      <h2 class="tipo-display display-md">Tres Registros en Una Sola Composición</h2>
      <p class="tipo-texto texto-md">
        Solo dos familias tipográficas: Unbounded (display) y Space Grotesk (texto y versalitas espaciadas). Prohibida tercera fuente.
      </p>

      <div class="demostracion-r7">
        <div class="linea-r7">
          <span class="tipo-rotulo tag-r7">ACTO I · N2</span>
          <span class="tipo-display display-xl frase-display">DISEÑO WEB</span>
          <span class="tipo-texto texto-lg frase-texto">arquitectura de interacción y código vivo,</span>
          <span class="tipo-versalitas frase-versalitas">RESOLUCIÓN ESPACIAL 60 FPS · COORDENADAS ZERO</span>
        </div>
      </div>
    </section>

    <!-- 4. Escala Tipográfica Fluida con clamp() -->
    <section class="estilo-seccion">
      <div class="tipo-rotulo rotulo-seccion">04 / ESCALA TIPOGRÁFICA FLUIDA</div>
      <h2 class="tipo-display display-md">Escala Adaptativa Modular (Base 16px)</h2>

      <div class="lista-escalas">
        <div class="item-escala">
          <span class="tipo-rotulo">--tamano-display-2xl (clamp 1.625rem a 5.5rem)</span>
          <div class="tipo-display display-2xl">Cinematografía</div>
        </div>
        <div class="item-escala">
          <span class="tipo-rotulo">--tamano-display-xl (clamp 2rem a 4rem)</span>
          <div class="tipo-display display-xl">Menú de Disciplinas</div>
        </div>
        <div class="item-escala">
          <span class="tipo-rotulo">--tamano-display-lg (clamp 1.5rem a 2.75rem)</span>
          <div class="tipo-display display-lg">Plano Infinito Landberg</div>
        </div>
        <div class="item-escala">
          <span class="tipo-rotulo">--tamano-display-md (clamp 1.25rem a 2rem)</span>
          <div class="tipo-display display-md">Flujo de Trabajo y Problema Resuelto</div>
        </div>
        <div class="item-escala">
          <span class="tipo-rotulo">--tamano-texto-lg (clamp 1.125rem a 1.35rem)</span>
          <div class="tipo-texto texto-lg">
            El personaje 3D anfitrión se transforma según la disciplina observada, sosteniendo el hilo conductor entre actos.
          </div>
        </div>
        <div class="item-escala">
          <span class="tipo-rotulo">--tamano-texto-md (clamp 1rem a 1.125rem — Base)</span>
          <div class="tipo-texto texto-md">
            Texto de cuerpo general para casos de estudio, documentación de proceso, navegación por teclado y especificaciones técnicas.
          </div>
        </div>
        <div class="item-escala">
          <span class="tipo-rotulo">--tamano-rotulo (clamp 0.72rem a 0.825rem — Versalitas)</span>
          <div class="tipo-rotulo">HUD PERSISTENTE · REGLA DE PROGRESO 100% · TIEMPO RESTANTE 00:42</div>
        </div>
      </div>
    </section>

    <!-- 5. Escala de Espaciado Modular (Razón 1.5) -->
    <section class="estilo-seccion">
      <div class="tipo-rotulo rotulo-seccion">05 / ESCALA DE ESPACIADO MODULAR</div>
      <h2 class="tipo-display display-md">Razón 1.5 (Quinta Justa) · Cero Mobiliario</h2>
      <p class="tipo-texto texto-md">
        El espacio negativo y la tipografía son la única herramienta de ordenación estructural. Sin bordes ni cajas.
      </p>

      <div class="muestrario-espaciado">
        <div class="fila-espacio"><span class="tipo-rotulo">3xs (4px)</span><div class="barra-espacio" style="width: var(--espacio-3xs);"></div></div>
        <div class="fila-espacio"><span class="tipo-rotulo">2xs (8px)</span><div class="barra-espacio" style="width: var(--espacio-2xs);"></div></div>
        <div class="fila-espacio"><span class="tipo-rotulo">xs (12px)</span><div class="barra-espacio" style="width: var(--espacio-xs);"></div></div>
        <div class="fila-espacio"><span class="tipo-rotulo">sm (16px — Base)</span><div class="barra-espacio" style="width: var(--espacio-sm);"></div></div>
        <div class="fila-espacio"><span class="tipo-rotulo">md (24px)</span><div class="barra-espacio" style="width: var(--espacio-md);"></div></div>
        <div class="fila-espacio"><span class="tipo-rotulo">lg (36px)</span><div class="barra-espacio" style="width: var(--espacio-lg);"></div></div>
        <div class="fila-espacio"><span class="tipo-rotulo">xl (54px)</span><div class="barra-espacio" style="width: var(--espacio-xl);"></div></div>
        <div class="fila-espacio"><span class="tipo-rotulo">2xl (81px)</span><div class="barra-espacio" style="width: var(--espacio-2xl);"></div></div>
        <div class="fila-espacio"><span class="tipo-rotulo">3xl (121.5px)</span><div class="barra-espacio" style="width: var(--espacio-3xl);"></div></div>
      </div>
    </section>

    <!-- 6. Jerarquía de Capas Z -->
    <section class="estilo-seccion">
      <div class="tipo-rotulo rotulo-seccion">06 / CAPAS Z NOMBRADAS Y BISAGRA NEGRA</div>
      <h2 class="tipo-display display-md">Profundidad Espacial Persistente</h2>

      <div class="tabla-capas-z">
        <div class="item-capa">
          <span class="tipo-display texto-md">--z-canvas: 1</span>
          <span class="tipo-texto texto-sm">Capa 0: Canvas persistente WebGL (Three.js). Fondo inmutable.</span>
        </div>
        <div class="item-capa">
          <span class="tipo-display texto-md">--z-video: 2</span>
          <span class="tipo-texto texto-sm">Capa 1: Reproductor H.264 de acrobacias y saltos de transición en N2.</span>
        </div>
        <div class="item-capa">
          <span class="tipo-display texto-md">--z-hinge: 5</span>
          <span class="tipo-texto texto-sm">Capa 2: Bisagra de negro absoluto inactiva (absorbe luz en reposo).</span>
        </div>
        <div class="item-capa">
          <span class="tipo-display texto-md">--z-stage: 10</span>
          <span class="tipo-texto texto-sm">Capa 3: Escenario DOM principal donde se montan los actos N0 a N4.</span>
        </div>
        <div class="item-capa">
          <span class="tipo-display texto-md">--z-hud: 20</span>
          <span class="tipo-texto texto-sm">Capa 4: HUD persistente desacoplado (regla superior, contador, retorno, CTA).</span>
        </div>
        <div class="item-capa item-capa-destacada">
          <span class="tipo-display texto-md">--z-hinge-active: 100</span>
          <span class="tipo-texto texto-sm">Bisagra ACTIVA: Se superpone a TODO (incluido el HUD) durante cambios de acto.</span>
        </div>
      </div>
    </section>

    <!-- 7. Curvas y Duraciones de Animación -->
    <section class="estilo-seccion">
      <div class="tipo-rotulo rotulo-seccion">07 / CURVAS Y DINÁMICAS CINEMÁTICAS</div>
      <h2 class="tipo-display display-md">Aceleraciones para GSAP y CSS</h2>

      <div class="muestrario-curvas">
        <div class="item-curva" data-curva="entrada">
          <span class="tipo-rotulo">--curva-entrada (cubic-bezier 0.16, 1, 0.3, 1)</span>
          <span class="tipo-texto texto-sm">Entrada cinematográfica desacelerada (power4.out).</span>
          <div class="caja-animacion">
            <div class="objeto-animado anim-entrada"></div>
          </div>
          <button type="button" class="btn-token btn-probar" data-target="anim-entrada">Probar Animación</button>
        </div>

        <div class="item-curva" data-curva="bisagra">
          <span class="tipo-rotulo">--curva-bisagra (cubic-bezier 0.65, 0, 0.35, 1)</span>
          <span class="tipo-texto texto-sm">Transición simétrica suave entre actos (power3.inOut).</span>
          <div class="caja-animacion">
            <div class="objeto-animado anim-bisagra"></div>
          </div>
          <button type="button" class="btn-token btn-probar" data-target="anim-bisagra">Probar Animación</button>
        </div>

        <div class="item-curva" data-curva="despliegue">
          <span class="tipo-rotulo">--curva-despliegue (cubic-bezier 0.25, 1, 0.5, 1)</span>
          <span class="tipo-texto texto-sm">Despliegue espacial de piezas en plano Landberg.</span>
          <div class="caja-animacion">
            <div class="objeto-animado anim-despliegue"></div>
          </div>
          <button type="button" class="btn-token btn-probar" data-target="anim-despliegue">Probar Animación</button>
        </div>
      </div>
    </section>
  </div>
</FilmLayout>

<style>
  /* ===================================================================
   * ESTILOS ESPECÍFICOS DE LA PÁGINA /estilo
   * Cumpliendo R19 (Cero mobiliario): Espacio negativo, sin cajas de card.
   * =================================================================== */
  .estilo-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--espacio-2xl) var(--espacio-md) var(--espacio-3xl);
    position: relative;
    z-index: var(--z-stage);
  }

  .estilo-header {
    margin-bottom: var(--espacio-3xl);
    padding-bottom: var(--espacio-xl);
  }

  .metadato-header {
    color: var(--color-activo);
    margin-bottom: var(--espacio-xs);
  }

  .titulo-estilo {
    margin: 0 0 var(--espacio-md);
  }

  .subtitulo-estilo {
    max-width: 760px;
    margin: 0;
    opacity: 0.85;
  }

  .estilo-seccion {
    margin-bottom: var(--espacio-3xl);
    padding-top: var(--espacio-xl);
  }

  .rotulo-seccion {
    color: var(--color-activo);
    margin-bottom: var(--espacio-xs);
  }

  /* Selector Interactivo de Nivel y Disciplina */
  .controles-grupo {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-sm);
    margin: var(--espacio-lg) 0;
  }

  .control-fila {
    display: flex;
    align-items: center;
    gap: var(--espacio-sm);
    flex-wrap: wrap;
  }

  .etiqueta-control {
    min-width: 110px;
  }

  .botones-selector {
    display: flex;
    gap: var(--espacio-xs);
    flex-wrap: wrap;
  }

  .btn-token {
    background: transparent;
    color: currentColor;
    border: 1px solid currentColor;
    font-family: var(--fuente-texto);
    font-size: var(--tamano-rotulo);
    font-weight: 600;
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    padding: var(--espacio-2xs) var(--espacio-sm);
    border-radius: var(--radio-sm);
    cursor: pointer;
    transition: background-color var(--duracion-corta) var(--curva-entrada),
                color var(--duracion-corta) var(--curva-entrada);
  }

  .btn-token:hover {
    background-color: var(--color-activo);
    color: var(--color-crema-base);
    border-color: var(--color-activo);
  }

  .btn-token.activo {
    background-color: var(--color-activo);
    color: var(--color-crema-base);
    border-color: var(--color-activo);
  }

  .indicador-valores-activos {
    margin-top: var(--espacio-lg);
    padding-top: var(--espacio-sm);
  }

  .grid-variables-activas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--espacio-xs);
    margin-top: var(--espacio-2xs);
    font-family: monospace;
    font-size: var(--tamano-rotulo);
  }

  /* Muestrario de Paleta Joya */
  .muestrario-paleta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--espacio-md);
    margin-top: var(--espacio-lg);
  }

  .muestra-color {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-xs);
  }

  .bloque-color {
    width: 100%;
    height: 90px;
    background-color: var(--color-local);
    border-radius: var(--radio-sm);
  }

  .datos-color {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  /* Muestrario de Cremas Teñidos */
  .muestrario-cremas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: var(--espacio-md);
    margin-top: var(--espacio-lg);
  }

  .item-crema {
    background-color: var(--fondo-demo);
    color: var(--color-texto-oscuro);
    padding: var(--espacio-md);
  }

  /* Editorial en N2: el fondo del video es oscuro y el texto pasa a claro (tokens.css). */
  .item-crema-invertido {
    color: var(--color-texto-claro);
  }

  .muestra-tinte {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-2xs);
  }

  /* Hereda el color del texto: el verde de 3D daba 3,55:1 sobre los fondos medidos de N2. */
  .valor-contraste {
    font-weight: 700;
  }

  /* R7 Demostración */
  .demostracion-r7 {
    margin-top: var(--espacio-lg);
    padding: var(--espacio-xl) 0;
  }

  .linea-r7 {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-sm);
  }

  .tag-r7 {
    color: var(--color-activo);
  }

  .frase-display {
    color: var(--color-activo);
  }

  /* Escala Tipográfica */
  .lista-escalas {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-lg);
    margin-top: var(--espacio-lg);
  }

  .item-escala {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-2xs);
    padding-bottom: var(--espacio-md);
  }

  /* Escala de Espaciado */
  .muestrario-espaciado {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-xs);
    margin-top: var(--espacio-lg);
  }

  .fila-espacio {
    display: flex;
    align-items: center;
    gap: var(--espacio-md);
  }

  .fila-espacio span {
    min-width: 140px;
  }

  .barra-espacio {
    height: 12px;
    background-color: var(--color-activo);
    border-radius: var(--radio-sm);
  }

  /* Tabla Capas Z */
  .tabla-capas-z {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-xs);
    margin-top: var(--espacio-lg);
  }

  .item-capa {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--espacio-xs) 0;
  }

  .item-capa-destacada {
    color: var(--color-casa);
    font-weight: 700;
  }

  /* Muestrario de Curvas */
  .muestrario-curvas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--espacio-lg);
    margin-top: var(--espacio-lg);
  }

  .item-curva {
    display: flex;
    flex-direction: column;
    gap: var(--espacio-2xs);
  }

  .caja-animacion {
    height: 48px;
    background: rgba(128, 128, 128, 0.1);
    border-radius: var(--radio-sm);
    position: relative;
    overflow: hidden;
    margin: var(--espacio-2xs) 0;
  }

  .objeto-animado {
    width: 24px;
    height: 100%;
    background-color: var(--color-activo);
    position: absolute;
    left: 0;
    top: 0;
  }

  .anim-entrada.corriendo {
    animation: moverCaja var(--duracion-larga) var(--curva-entrada) forwards;
  }

  .anim-bisagra.corriendo {
    animation: moverCaja var(--duracion-bisagra) var(--curva-bisagra) forwards;
  }

  .anim-despliegue.corriendo {
    animation: moverCaja var(--duracion-despliegue) var(--curva-despliegue) forwards;
  }

  @keyframes moverCaja {
    0% { transform: translateX(0); }
    100% { transform: translateX(calc(100% * 8)); }
  }

  @media (max-width: 768px) {
    .estilo-container {
      padding-left: var(--espacio-sm);
      padding-right: var(--espacio-sm);
    }

    .item-capa {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }
  }
</style>

<script>
  // Script del inspector interactivo de tokens y animaciones
  const nivelBtns = document.querySelectorAll<HTMLButtonElement>('#selector-nivel button');
  const disciplinaBtns = document.querySelectorAll<HTMLButtonElement>('#selector-disciplina button');

  const valColor = document.getElementById('val-color-activo');
  const valFondo = document.getElementById('val-fondo-activo');
  const valTexto = document.getElementById('val-texto-activo');
  const valAcento = document.getElementById('val-acento-activo');

  function updateInspectors() {
    const computed = getComputedStyle(document.body);
    if (valColor) valColor.textContent = computed.getPropertyValue('--color-activo').trim() || '-';
    if (valFondo) valFondo.textContent = computed.getPropertyValue('--fondo-activo').trim() || '-';
    if (valTexto) valTexto.textContent = computed.getPropertyValue('--texto-activo').trim() || '-';
    if (valAcento) valAcento.textContent = computed.getPropertyValue('--acento-activo').trim() || '-';
  }

  nivelBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      nivelBtns.forEach((b) => b.classList.remove('activo'));
      btn.classList.add('activo');
      const nivel = btn.dataset.nivel;
      if (nivel) {
        document.body.dataset.currentLevel = nivel;
        updateInspectors();
      }
    });
  });

  disciplinaBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      disciplinaBtns.forEach((b) => b.classList.remove('activo'));
      btn.classList.add('activo');
      const disciplina = btn.dataset.disciplina;
      if (disciplina) {
        document.body.dataset.discipline = disciplina;
        updateInspectors();
      }
    });
  });

  // Botones para disparar animaciones de curvas
  const testBtns = document.querySelectorAll<HTMLButtonElement>('.btn-probar');
  testBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetClass = btn.dataset.target;
      if (targetClass) {
        const el = document.querySelector(`.${targetClass}`);
        if (el instanceof HTMLElement) {
          el.classList.remove('corriendo');
          // Forzar reflujo
          void el.offsetWidth;
          el.classList.add('corriendo');
        }
      }
    });
  });

  // Inicialización de inspectores
  updateInspectors();
</script>
